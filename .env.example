# Copy this file to `.env` (gitignored) and fill in your secrets.
# All settings are optional — defaults work for paper trading.

# Bybit API credentials.
# Not required for v1 (paper trading uses public market data only).
# Add them later for higher REST rate limits and private endpoints.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Use Bybit testnet instead of production.
BYBIT_TESTNET=false

# Disable hot-reload of bots/ in production.
BOT_HOT_RELOAD=true
